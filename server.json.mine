{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
  "name": "io.github.mbilalawan926-sys/best-tempmail-mcp",
  "description": "Disposable email inboxes for AI agents: create, wait for mail, extract verification codes",
  "version": "1.0.1",
  "repository": {
    "url": "https://github.com/mbilalawan926-sys/best-tempmail-mcp",
    "source": "github"
  },
  "websiteUrl": "https://best-tempmail.com/api",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "best-tempmail-mcp",
      "version": "1.0.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "BTM_API_KEY",
          "description": "Optional paid plan key. Without it the free tier applies, which needs no key but cannot extract verification codes.",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ]
}
